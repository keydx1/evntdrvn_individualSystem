{
  "name": "aquapiol",
  "version": "1.0.0",
  "description": "AquaPiol Water Refilling Station Inventory Management System — XianFire Framework",
  "main": "index.js",
  "type": "module",
  "bin": {
    "xian": "./bin/xian.js"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "xian": "nodemon index.js",
    "migrate": "node migrate.js",
