{{> shell-start}}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/users">Users</a>
  <span class="crumb-sep">/</span>
  <span>{{#if isEdit}}Edit user{{else}}New user{{/if}}</span>
</nav>

<section class="page-intro compact">
  <div>
    <span class="eyebrow">Access control</span>
    <h2>{{#if isEdit}}{{ account.name }}{{else}}Add a user account{{/if}}</h2>
    <p>{{#if isEdit}}Update the role, reset the password or deactivate the account.{{else}}Create an account and give it a role.{{/if}}</p>
  </div>
</section>

<form class="form-card narrow" method="POST" action="{{#if isEdit}}/users/{{ account.id }}{{else}}/users{{/if}}">
  {{> csrf}}
  {{> form-errors}}

  <section class="form-section">
    <div class="form-section-head">
      <span class="section-number">01</span>
      <div>
        <h3>Account details</h3>
        <p>Email addresses are used as the sign-in identifier.</p>
      </div>
    </div>

    <div class="form-grid">
      <div class="field">
        <label for="name">Full name <span class="required">*</span></label>
        <input
          type="text"
          id="name"
          name="name"
          value="{{ values.name }}"
          maxlength="120"
          placeholder="e.g. Maria Santos"
          required
          autofocus
        >
      </div>

      <div class="field">
        <label for="email">Email address <span class="required">*</span></label>
        <input
          type="email"
          id="email"
          name="email"
          value="{{ values.email }}"
          maxlength="150"
          placeholder="name@aquapiol.local"
          required
        >
      </div>

      <div class="field">
        <label for="role">Role <span class="required">*</span></label>
        <select id="role" name="role" required>
          {{#each roles}}
            <option value="{{ key }}" {{selected ../values.role key}}>{{ name }}{{#if description}} — {{ description }}{{/if}}</option>
          {{/each}}
        </select>
        <span class="hint">What this account can do comes from its role. Edit the permissions in <a href="/roles">Roles &amp; permissions</a>.</span>
      </div>

      <div class="field">
        <label for="password">
          {{#if isEdit}}New password{{else}}Password{{/if}}
          {{#unless isEdit}}<span class="required">*</span>{{/unless}}
        </label>
        <input
          type="password"
          id="password"
          name="password"
          minlength="8"
          maxlength="72"
          placeholder="{{#if isEdit}}Leave blank to keep the current password{{else}}At least 8 characters{{/if}}"
          {{#unless isEdit}}required{{/unless}}
        >
        <span class="hint">Passwords are hashed before storage.</span>
      </div>

      {{#if isEdit}}
        <div class="field field-full">
          <label class="checkbox-row" for="isActive">
            <input type="checkbox" id="isActive" name="isActive" {{checked values.isActive}}>
            <span>
              <strong>Account is active</strong>
              <small>Inactive accounts cannot sign in, but their movement history is kept.</small>
            </span>
          </label>
        </div>
      {{/if}}
    </div>
  </section>

  <div class="form-actions">
    <a href="/users" class="btn btn-ghost">Cancel</a>
    <button type="submit" class="btn btn-primary">
      <svg class="icon" aria-hidden="true"><use href="#i-check-circle"></use></svg>
      {{#if isEdit}}Save user{{else}}Create user{{/if}}
    </button>
  </div>
</form>

{{> shell-end}}
