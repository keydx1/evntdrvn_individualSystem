{{> shell-start}}

<section class="page-intro">
  <div>
    <span class="eyebrow">Replenishment</span>
    <h2>Low stock alerts</h2>
    <p>Products at or below their reorder level, with the supplier to call and the quantity to order.</p>
  </div>
  <div class="header-actions">
    <a href="/products?status=low" class="btn btn-secondary">
      <svg class="icon" aria-hidden="true"><use href="#i-box"></use></svg>
      Open products
    </a>
    <a href="/stock/in" class="btn btn-primary">
      <svg class="icon" aria-hidden="true"><use href="#i-arrow-down"></use></svg>
      Record delivery
    </a>
  </div>
</section>

{{#if alertTotal}}
  <div class="alert alert-warning">
    <svg class="icon" aria-hidden="true"><use href="#i-alert"></use></svg>
    <div>
      <p>
        {{ alertTotal }} product{{#if (ne alertTotal 1)}}s{{/if}} need attention:
        {{ outOfStock.length }} out of stock and {{ lowStock.length }} running low.
      </p>
    </div>
  </div>
{{else}}
  <div class="alert alert-success">
    <svg class="icon" aria-hidden="true"><use href="#i-check-circle"></use></svg>
    <div>
      <p>Every active product is above its reorder level. No replenishment is needed right now.</p>
    </div>
  </div>
{{/if}}

<section class="stat-grid stat-grid-four">
  <article class="stat-card">
    <div class="stat-icon amber"><svg class="icon" aria-hidden="true"><use href="#i-alert"></use></svg></div>
    <div class="stat-copy">
      <span class="stat-label">Out of stock</span>
      <strong class="stat-value">{{ number outOfStock.length }}</strong>
      <span class="stat-meta">Cannot be released until replenished</span>
    </div>
  </article>
  <article class="stat-card">
    <div class="stat-icon blue"><svg class="icon" aria-hidden="true"><use href="#i-box"></use></svg></div>
    <div class="stat-copy">
      <span class="stat-label">Low stock</span>
      <strong class="stat-value">{{ number lowStock.length }}</strong>
      <span class="stat-meta">At or below the reorder level</span>
    </div>
  </article>
  <article class="stat-card">
    <div class="stat-icon aqua"><svg class="icon" aria-hidden="true"><use href="#i-swap"></use></svg></div>
    <div class="stat-copy">
      <span class="stat-label">Units short</span>
      <strong class="stat-value">{{ number unitsShort }}</strong>
      <span class="stat-meta">To reach the reorder level</span>
    </div>
  </article>
  <article class="stat-card">
    <div class="stat-icon green"><svg class="icon" aria-hidden="true"><use href="#i-chart"></use></svg></div>
    <div class="stat-copy">
      <span class="stat-label">Restock value</span>
      <strong class="stat-value">{{ money restockValue }}</strong>
      <span class="stat-meta">Estimated at cost price</span>
    </div>
  </article>
</section>

<form class="filter-bar" method="GET" action="/alerts">
  <div class="field">
    <label for="status">Alert type</label>
    <select id="status" name="status">
      <option value="" {{selected filters.status ""}}>All alerts</option>
      <option value="out" {{selected filters.status "out"}}>Out of stock</option>
      <option value="low" {{selected filters.status "low"}}>Low stock</option>
    </select>
  </div>

  <div class="field">
    <label for="category">Category</label>
    <select id="category" name="category">
      <option value="">All categories</option>
      {{#each categories}}
        <option value="{{ id }}" {{selected ../filters.category id}}>{{ name }}</option>
      {{/each}}
    </select>
  </div>

  <button type="submit" class="btn btn-secondary">Filter</button>
  <a href="/alerts" class="btn btn-ghost">Reset</a>
</form>

<section class="panel panel-flush">
  <div class="panel-head panel-head-inside">
    <div>
      <h3>{{ number resultCount }} alert{{#if (ne resultCount 1)}}s{{/if}}</h3>
      <p class="panel-subtitle">Out-of-stock items are listed first. Order the shortfall shown below.</p>
    </div>
    <div class="legend">
      <span class="legend-item"><i class="dot warning"></i> Low</span>
      <span class="legend-item"><i class="dot danger"></i> Out</span>
    </div>
  </div>

  {{#if alerts.length}}
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Category</th>
            <th class="text-right">On hand</th>
            <th class="text-right">Reorder at</th>
            <th class="text-right">Shortfall</th>
            <th>Supplier</th>
            <th>Status</th>
            <th class="text-right">Action</th>
          </tr>
        </thead>
        <tbody>
          {{#each alerts}}
            <tr>
              <td>
                <a class="table-title" href="/products/{{ id }}">{{ name }}</a>
                <span class="table-subtitle">{{ sku }}</span>
              </td>
              <td><span class="category-chip">{{ category.name }}</span></td>
              <td class="text-right nowrap">
                <strong class="stock-number">{{ number quantity }}</strong>
                <span class="unit-label">{{ unit }}</span>
              </td>
              <td class="text-right nowrap muted">{{ number reorderLevel }}</td>
              <td class="text-right nowrap">
                <strong>{{ number shortfall }}</strong>
                <span class="unit-label">{{ unit }}</span>
              </td>
              <td>
                {{#if supplier}}
                  <strong class="cell-date">{{ supplier.name }}</strong>
                  {{#if supplier.phone}}<span class="table-subtitle">{{ supplier.phone }}</span>{{/if}}
                {{else}}
                  <span class="muted">No supplier</span>
                {{/if}}
              </td>
              <td><span class="badge badge-{{ status.className }}">{{ status.label }}</span></td>
              <td class="text-right">
                <a class="btn btn-secondary btn-sm" href="/stock/in?productId={{ id }}">Stock in</a>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{else}}
    <div class="empty-state large">
      <span class="empty-icon"><svg class="icon" aria-hidden="true"><use href="#i-check-circle"></use></svg></span>
      <h4>{{#if alertTotal}}No alerts match this filter{{else}}Stock levels look healthy{{/if}}</h4>
      <p>{{#if alertTotal}}Try a different alert type or category.{{else}}Nothing is at or below its reorder level.{{/if}}</p>
      {{#if alertTotal}}
        <a href="/alerts" class="btn btn-secondary">Clear filters</a>
      {{/if}}
    </div>
  {{/if}}
</section>

{{> shell-end}}
