{{> svg-sprite}}



<aside class="sidebar" id="sidebar">
  <a class="brand" href="/">
    <span class="brand-mark"><svg class="icon" aria-hidden="true"><use href="#i-drop"></use></svg></span>
    <span class="brand-copy">
      <strong>AquaPiol</strong>
      <small>Water Refilling Station</small>
    </span>
  </a>

  <nav class="sidebar-nav" aria-label="Main navigation">
    <p class="nav-label">Workspace</p>
    <a class="nav-link {{#if (eq active 'dashboard')}}active{{/if}}" href="/">
      <svg class="icon" aria-hidden="true"><use href="#i-grid"></use></svg>
      <span>Dashboard</span>
    </a>

    <p class="nav-label">Inventory</p>
    <a class="nav-link {{#if (eq active 'products')}}active{{/if}}" href="/products">
      <svg class="icon" aria-hidden="true"><use href="#i-box"></use></svg>
      <span>Products</span>
    </a>
    <a class="nav-link {{#if (eq active 'alerts')}}active{{/if}}" href="/alerts">
      <svg class="icon" aria-hidden="true"><use href="#i-alert"></use></svg>
      <span>Low stock alerts</span>
      {{#if (gt alertCount 0)}}<span class="nav-badge">{{ alertCount }}</span>{{/if}}
    </a>
    <a class="nav-link {{#if (eq active 'stock')}}active{{/if}}" href="/stock">
      <svg class="icon" aria-hidden="true"><use href="#i-swap"></use></svg>
      <span>Inventory history</span>
    </a>
    <a class="nav-link {{#if (eq active 'categories')}}active{{/if}}" href="/categories">
      <svg class="icon" aria-hidden="true"><use href="#i-tag"></use></svg>
      <span>Categories</span>
    </a>
    <a class="nav-link {{#if (eq active 'suppliers')}}active{{/if}}" href="/suppliers">
      <svg class="icon" aria-hidden="true"><use href="#i-truck"></use></svg>
      <span>Suppliers</span>
    </a>

    <p class="nav-label">Insights</p>
    <a class="nav-link {{#if (eq active 'reports')}}active{{/if}}" href="/reports">
      <svg class="icon" aria-hidden="true"><use href="#i-chart"></use></svg>
      <span>Reports</span>
    </a>

    {{#if (or canManageUsers canManageRoles)}}
      <p class="nav-label">Administration</p>
      {{#if canManageUsers}}
        <a class="nav-link {{#if (eq active 'users')}}active{{/if}}" href="/users">
          <svg class="icon" aria-hidden="true"><use href="#i-users"></use></svg>
          <span>Users</span>
        </a>
      {{/if}}
      {{#if canManageRoles}}
        <a class="nav-link {{#if (eq active 'roles')}}active{{/if}}" href="/roles">
          <svg class="icon" aria-hidden="true"><use href="#i-eye"></use></svg>
          <span>Roles &amp; permissions</span>
        </a>
      {{/if}}
    {{/if}}
  </nav>

  <div class="sidebar-footer">
    {{#if currentUser}}
      <div class="sidebar-user">
        <span class="avatar">{{ initials currentUser.name }}</span>
        <span class="sidebar-user-copy">
          <strong>{{ currentUser.name }}</strong>
          <small>{{#if currentRoleName}}{{ currentRoleName }}{{else}}{{ roleLabel currentUser.role }}{{/if}}</small>
        </span>
      </div>
    {{/if}}
    <form action="/logout" method="POST">
      {{> csrf}}
      <button type="submit" class="sidebar-logout">
        <svg class="icon" aria-hidden="true"><use href="#i-logout"></use></svg>
        <span>Sign out</span>
      </button>
    </form>
    <p class="sidebar-note">Powered by XianFire</p>
  </div>
</aside>
<div class="sidebar-scrim" data-sidebar-close></div>
