{{> shell-start}}

<section class="page-intro">
  <div>
    <span class="eyebrow">Supply network</span>
    <h2>Suppliers</h2>
    <p>Keep delivery contacts close and see how much inventory each supplier supports.</p>
  </div>
  {{#if (can "suppliers.manage")}}
  <a href="/suppliers/new" class="btn btn-primary">
    <svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg>
    Add supplier
  </a>
  {{/if}}
</section>

<section class="panel panel-flush">
  <div class="panel-head panel-head-inside">
    <div>
      <h3>{{ suppliers.length }} supplier{{#if (ne suppliers.length 1)}}s{{/if}}</h3>
      <p class="panel-subtitle">Suppliers with linked products or stock history cannot be deleted.</p>
    </div>
  </div>

  {{#if suppliers.length}}
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Supplier</th>
            <th>Contact</th>
            <th>Phone</th>
            <th>Email</th>
            <th class="text-right">Products</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each suppliers}}
            <tr>
              <td>
                <span class="supplier-name">
                  <span class="avatar avatar-sm">{{ initials name }}</span>
                  <span>
                    <strong>{{ name }}</strong>
                    {{#if address}}<small>{{ address }}</small>{{/if}}
                  </span>
                </span>
              </td>
              <td>{{#if contactPerson}}{{ contactPerson }}{{else}}<span class="muted">—</span>{{/if}}</td>
              <td class="nowrap">{{#if phone}}{{ phone }}{{else}}<span class="muted">—</span>{{/if}}</td>
              <td>{{#if email}}<a class="text-link" href="mailto:{{ email }}">{{ email }}</a>{{else}}<span class="muted">—</span>{{/if}}</td>
              <td class="text-right">
                <strong>{{ number productCount }}</strong>
                <span class="table-subtitle">{{ number totalUnits }} units</span>
              </td>
              <td>
                <div class="row-actions">
                  {{#if (can "suppliers.manage")}}
                  <a class="icon-btn" href="/suppliers/{{ id }}/edit" title="Edit {{ name }}">
                    <svg class="icon" aria-hidden="true"><use href="#i-edit"></use></svg>
                  </a>
                  <form action="/suppliers/{{ id }}/delete" method="POST" data-confirm="Delete {{ name }}? This cannot be undone.">
                    <input type="hidden" name="_csrf" value="{{ ../csrfToken }}">
                    <button type="submit" class="icon-btn danger" title="Delete {{ name }}">
                      <svg class="icon" aria-hidden="true"><use href="#i-trash"></use></svg>
                    </button>
                  </form>
                  {{/if}}
                </div>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{else}}
    <div class="empty-state large">
      <span class="empty-icon"><svg class="icon" aria-hidden="true"><use href="#i-truck"></use></svg></span>
      <h4>No suppliers yet</h4>
      <p>Add the businesses that deliver bottles, filters and station supplies.</p>
      {{#if (can "suppliers.manage")}}
      <a href="/suppliers/new" class="btn btn-primary">Add supplier</a>
      {{/if}}
    </div>
  {{/if}}
</section>

{{> shell-end}}
