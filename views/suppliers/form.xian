{{> shell-start}}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/suppliers">Suppliers</a>
  <span class="crumb-sep">/</span>
  <span>{{#if isEdit}}Edit supplier{{else}}New supplier{{/if}}</span>
</nav>

<section class="page-intro compact">
  <div>
    <span class="eyebrow">Supply network</span>
    <h2>{{#if isEdit}}{{ supplier.name }}{{else}}Add a supplier{{/if}}</h2>
    <p>Contact details are used when recording deliveries against the stock ledger.</p>
  </div>
</section>

<form class="form-card" method="POST" action="{{#if isEdit}}/suppliers/{{ supplier.id }}{{else}}/suppliers{{/if}}">
  {{> csrf}}
  {{> form-errors}}

  <section class="form-section">
    <div class="form-section-head">
      <span class="section-number">01</span>
      <div>
        <h3>Business details</h3>
        <p>The supplier name must be unique.</p>
      </div>
    </div>

    <div class="form-grid">
      <div class="field">
        <label for="name">Supplier name <span class="required">*</span></label>
        <input
          type="text"
          id="name"
          name="name"
          value="{{ values.name }}"
          maxlength="150"
          placeholder="e.g. AquaTech Water Solutions"
          required
          autofocus
        >
      </div>

      <div class="field">
        <label for="contactPerson">Contact person</label>
        <input
          type="text"
          id="contactPerson"
          name="contactPerson"
          value="{{ values.contactPerson }}"
          maxlength="120"
          placeholder="Full name"
        >
      </div>

      <div class="field">
        <label for="phone">Phone number</label>
        <input
          type="text"
          id="phone"
          name="phone"
          value="{{ values.phone }}"
          maxlength="40"
          placeholder="e.g. 0917 555 0142"
        >
      </div>

      <div class="field">
        <label for="email">Email address</label>
        <input
          type="email"
          id="email"
          name="email"
          value="{{ values.email }}"
          maxlength="150"
          placeholder="orders@supplier.ph"
        >
      </div>

      <div class="field field-full">
        <label for="address">Address</label>
        <input
          type="text"
          id="address"
          name="address"
          value="{{ values.address }}"
          maxlength="255"
          placeholder="Street, city, province"
        >
      </div>

      <div class="field field-full">
        <label for="notes">Notes</label>
        <textarea
          id="notes"
          name="notes"
          rows="3"
          maxlength="1000"
          placeholder="Delivery schedule, payment terms or other reminders."
        >{{ values.notes }}</textarea>
      </div>
    </div>
  </section>

  <div class="form-actions">
    <a href="/suppliers" class="btn btn-ghost">Cancel</a>
    <button type="submit" class="btn btn-primary">
      <svg class="icon" aria-hidden="true"><use href="#i-check-circle"></use></svg>
      {{#if isEdit}}Save supplier{{else}}Create supplier{{/if}}
    </button>
  </div>
</form>

{{> shell-end}}
