# Copy this file to .env to override the local defaults.
PORT=3000

# Use a long random value outside local development.
SESSION_SECRET=replace-this-with-a-long-random-secret

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aquapiol_inventory
DB_USER=root
DB_PASSWORD=
DB_TIMEZONE=+08:00

# Service tokens for the integration API (JSON: service -> token).
# Generate one strong random token per system and never commit real values.
API_TOKENS={"pos":"replace-with-random-token","customers":"replace-with-random-token","hr":"replace-with-random-token","accounting":"replace-with-random-token"}

# Optional scope overrides per service (defaults: pos=read+write, others=read+ledger).
# API_SCOPES={"pos":["inventory:read","inventory:write"]}

IDEMPOTENCY_TTL_DAYS=7
RATE_LIMIT_PER_MIN=120
CORS_ORIGINS=
LOG_LEVEL=info
